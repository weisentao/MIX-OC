# App
NODE_ENV=production
PORT=13001
API_PREFIX=/api
LOG_LEVEL=info
REQUEST_BODY_LIMIT=10mb

# Browser CORS
# Replace with the deployed frontend origin before public launch.
CORS_ORIGIN=https://your-frontend.example.com
CORS_CREDENTIALS=false
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Auth
JWT_SECRET=replace-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=24h
# Fixed first-version super admin is admin/admin; do not configure an env override.

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xjg_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=xjg
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT=5000

# Redis (reserved for phase 2+)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI / DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_HOME_API_KEY=
DEEPSEEK_HR_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_MS=20000
AI_DATA_DIR=
