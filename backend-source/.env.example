# App
# NODE_ENV: development | production
NODE_ENV=development
# Backend listen port. Frontend Vite proxy should point /api to this port.
PORT=13001
API_PREFIX=/api
LOG_LEVEL=info
# Optional. Production defaults to 10mb when omitted; development defaults to 80mb.
REQUEST_BODY_LIMIT=80mb

# Browser CORS. Required in production.
# Use comma-separated origins, for example:
# CORS_ORIGIN=https://your-frontend.example.com,http://localhost:15173
CORS_ORIGIN=
CORS_CREDENTIALS=false
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# JWT
# REQUIRED FOR PRODUCTION:
# - Must be replaced with a long random secret before launch.
# - Do not use the example value below in production.
# - `npm run db:check:production` reports FAIL_ENV_INVALID when this is empty or a known placeholder.
JWT_SECRET=replace-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=24h

# Admin account seed password.
# The fixed super admin remains admin/admin for first-version local acceptance.
# This value is intentionally not configurable by env.

# MySQL
# If MySQL is reachable:
# - backend auto creates auth/workspace tables on startup
# - real users from the local user list become login users (default password MIX801002)
# If MySQL is unreachable:
# - backend still starts in memory fallback mode
# - /appState/main fallback remains available
# Production recommendation:
# - Use a dedicated app user such as xjg_app.
# - Do not use root for production runtime.
# - MYSQL_DATABASE must stay xjg.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xjg_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=xjg
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT=5000

# Production MySQL example:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=xjg
# MYSQL_USER=xjg_app
# MYSQL_PASSWORD=please-replace

# Redis (reserved for phase 2+)
# Redis check failure does NOT block backend startup in current phase.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI / DeepSeek
# Backend only. Do not place real keys in frontend env, docs, requests, or responses.
# Home AI uses DEEPSEEK_HOME_API_KEY first; HR advice uses DEEPSEEK_HR_API_KEY first.
# DEEPSEEK_API_KEY is only a backend compatibility fallback for both scenarios.
DEEPSEEK_API_KEY=
DEEPSEEK_HOME_API_KEY=
DEEPSEEK_HR_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_MS=20000
AI_DATA_DIR=
